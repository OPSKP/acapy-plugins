NGROK_AUTHTOKEN=your-ngrok-authtoken

# Keycloak admin console credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Service account client the issuer uses to talk to Keycloak
KEYCLOAK_CLIENT_ID=acapy-issuer
KEYCLOAK_CLIENT_SECRET=acapy-issuer-secret

# Keycloak's public ngrok base URL (no realm path) — used by the frontend to
# configure the issuer's public authorization_server URL for wallets.
# Set this to your ngrok tunnel URL for the keycloak tunnel.
#Optional: omit to fall back to localhost:9001 (local testing only)
#KEYCLOAK_NGROK_URL=https://abc123.ngrok.io
